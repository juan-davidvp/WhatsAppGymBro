# Variables de entorno de Gym Bro (plan técnico §10).
# Copiar a app/infra/.env y completar. app/infra/.env NUNCA se versiona (RN-DAT-006).
# Lo leen el servidor (pnpm dev, dentro de app/) y Docker Compose.

# ── Telegram ────────────────────────────────────────────────────────────────
# Token de BotFather. Obligatorio.
TELEGRAM_BOT_TOKEN=
# Secreto del webhook (solo producción).
TELEGRAM_WEBHOOK_SECRET=

# ── MongoDB local (docker-compose.yml) ──────────────────────────────────────
# Usuario raíz: solo para administrar el contenedor.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
# Usuario de la aplicación: readWrite solo sobre MONGO_DATABASE.
MONGO_DATABASE=gymbro
MONGO_APP_USERNAME=gymbro_app
MONGO_APP_PASSWORD=
MONGO_PORT=27017
# Conexión que usa el servidor: el mismo usuario y contraseña de la aplicación.
# Si la contraseña tiene caracteres especiales, codificarla para URL.
MONGODB_URI=mongodb://gymbro_app:CAMBIAR_POR_MONGO_APP_PASSWORD@localhost:27017/gymbro?authSource=gymbro

# ── IA (Should) ─────────────────────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=

# ── Ingesta e integración ───────────────────────────────────────────────────
INGESTION_TOKEN_PEPPER=
APP_BASE_URL=http://localhost:3000

# ── General ─────────────────────────────────────────────────────────────────
# Zona horaria por defecto (P-069).
DEFAULT_TZ=America/Bogota
# debug · info · warn · error
LOG_LEVEL=info
